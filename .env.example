# Copy this file to `.env` (or `.env.local`) and adjust values as needed.
# All variables are read at build time by Vite and must be prefixed with VITE_.
# None of these are required — sensible defaults are used if omitted.

# Shown as the GitHub link in the header. Point this at your fork/mirror.
VITE_GITHUB_URL=https://github.com/your-org/docmarkdown

# Canonical site URL used for SEO tags (Open Graph, Twitter, canonical link)
# and for public/sitemap.xml / public/robots.txt. Set this to your deployed
# domain before shipping to production.
VITE_SITE_URL=https://docmarkdown.app

# Maximum size (in megabytes) for uploaded .md/.txt files.
VITE_MAX_UPLOAD_SIZE_MB=5

# Set to "true" to enable the (currently no-op) analytics abstraction.
# See src/services/analytics for details. Disabled by default; no analytics
# script is loaded regardless of this flag unless you implement a provider.
VITE_ENABLE_ANALYTICS=false
